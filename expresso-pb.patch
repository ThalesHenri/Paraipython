+{% load static %}<!DOCTYPE html>
+<html lang="pt-BR">
+<head>
+<meta charset="utf-8">
+<title>Expresso PB — Edição Nº {{ edicao.numero_edicao }}</title>
+{# base_url do WeasyPrint aponta para src/static, então o caminho é relativo a ele #}
+<link rel="stylesheet" href="fonts/fonts.css">
+<style>
+  @page {
+    size: A4;
+    margin: 13mm 12mm 16mm 12mm;
+    background: #f4ecd8;
+    @bottom-left {
+      content: "Expresso PB · Edição Nº {{ edicao.numero_edicao }} · tirada na hora";
+      font: italic 7.5pt "Old Standard TT", serif; color: #5a4f43;
+    }
+    @bottom-right {
+      content: "Página " counter(page) " de " counter(pages);
+      font: italic 7.5pt "Old Standard TT", serif; color: #5a4f43;
+    }
+  }
+  @page :first { @bottom-left { content: none; } }
+
+  :root { --tinta: #1a1815; --vermelho: #7a1010; --fio: #3a322b; }
+  * { box-sizing: border-box; }
+  html { color: var(--tinta); font-family: "Old Standard TT", "Merriweather", Georgia, serif;
+         font-size: 9.6pt; line-height: 1.32; }
+  body { margin: 0; }
+  p { margin: 0; }
+
+  /* ---------- Cabeçalho ---------- */
+  .faixa-topo { display: flex; justify-content: space-between; font-size: 7.5pt;
+                text-transform: uppercase; letter-spacing: 1.2pt; border-bottom: 0.6pt solid var(--fio);
+                padding-bottom: 2pt; }
+  .cabecalho { display: flex; align-items: center; justify-content: space-between; margin-top: 4pt; }
+  .orelha { width: 36mm; text-align: center; font-size: 6.4pt; line-height: 1.3;
+            text-transform: uppercase; letter-spacing: 0.5pt; }
+  .orelha img { width: 27mm; display: block; margin: 0 auto 1pt; }
+  .orelha.caixa { border: 1.2pt double var(--fio); padding: 4pt 3pt; }
+  .orelha.caixa strong { display: block; font-family: "Playfair Display", serif; font-size: 10pt;
+                         letter-spacing: 0.4pt; text-transform: none; color: var(--vermelho); }
+  .titulo-jornal { flex: 1; font-family: "UnifrakturMaguntia", serif; font-weight: 400; font-size: 64pt;
+                   line-height: 1; text-align: center; margin: 0; letter-spacing: 0.5pt; }
+  .titulo-jornal .pb { font-family: "Playfair Display", serif; font-weight: 900; font-size: 40pt;
+                       color: var(--vermelho); letter-spacing: 1pt; vertical-align: 6pt; }
+  .mancha { position: absolute; top: -9mm; right: -10mm; width: 56mm; transform: rotate(18deg); }
+  .lema { text-align: center; font-style: italic; font-size: 9pt; margin: 2pt 0 5pt; }
+  .barra-edicao { display: flex; justify-content: space-between; border-top: 2.4pt double var(--fio);
+                  border-bottom: 2.4pt double var(--fio); padding: 3pt 2pt; font-size: 8pt;
+                  text-transform: uppercase; letter-spacing: 0.8pt; margin-bottom: 9pt; }
+  .barra-edicao .data { font-weight: 700; }
+
+  /* ---------- Manchete ---------- */
+  .manchete { border-bottom: 1.2pt solid var(--fio); padding-bottom: 9pt; margin-bottom: 9pt; }
+  .manchete .chapeu { text-align: center; }
+  .manchete h1 { font-family: "Playfair Display", serif; font-weight: 900; font-size: 27pt;
+                 line-height: 1.05; text-align: center; margin: 2pt 0 7pt; }
+  .manchete .texto { columns: 2; column-gap: 14pt; column-rule: 0.5pt solid #b9ab8c;
+                     font-size: 11pt; line-height: 1.38; text-align: justify; hyphens: auto; }
+  .manchete .texto::first-letter { font-family: "Playfair Display", serif; font-weight: 900;
+                     float: left; font-size: 38pt; line-height: 0.8; padding: 3pt 4pt 0 0;
+                     color: var(--vermelho); }
+  .manchete .assinatura { text-align: right; margin-top: 5pt; font-size: 7.6pt; }
+
+  /* ---------- Demais notícias em 3 colunas ---------- */
+  .colunas { columns: 3; column-gap: 12pt; column-rule: 0.5pt solid #b9ab8c; }
+  .materia { break-inside: avoid; padding-bottom: 7pt; margin-bottom: 7pt;
+             border-bottom: 0.5pt solid #b9ab8c; }
+  .chapeu { font-size: 6.8pt; text-transform: uppercase; letter-spacing: 1.4pt;
+            color: var(--vermelho); font-weight: 700; }
+  .materia h2 { font-family: "Playfair Display", serif; font-weight: 700; font-size: 12.5pt;
+                line-height: 1.12; margin: 1pt 0 3pt; }
+  .materia .texto { text-align: justify; hyphens: auto; }
+  .assinatura { margin-top: 3pt; font-size: 7pt; font-style: italic; color: #4a4036; }
+  .assinatura strong { font-style: normal; }
+  .ref { font-style: normal; font-weight: 700; color: var(--vermelho); white-space: nowrap; }
+
+  /* ---------- Referências ---------- */
+  .referencias { margin-top: 8pt; border-top: 2.4pt double var(--fio); padding-top: 5pt; }
+  .referencias h3 { font-family: "UnifrakturMaguntia", serif; font-weight: 400; font-size: 17pt;
+                    text-align: center; margin: 0 0 1pt; }
+  .referencias .nota { text-align: center; font-style: italic; font-size: 7.4pt; margin-bottom: 6pt; }
+  .referencias ol { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 14pt;
+                    column-rule: 0.5pt solid #b9ab8c; font-size: 7pt; line-height: 1.3; }
+  .referencias li { break-inside: avoid; margin-bottom: 4pt; padding-left: 16pt; text-indent: -16pt; }
+  .referencias .num { display: inline-block; width: 16pt; text-indent: 0; font-weight: 700;
+                      color: var(--vermelho); }
+  .referencias .titulo { font-style: italic; }
+  .referencias .url { font-size: 6.4pt; color: #4a4036; word-break: break-all; hyphens: none; }
+
+  /* ---------- Expediente ---------- */
+  .expediente { break-inside: avoid; margin-top: 4pt; border: 1.2pt double var(--fio);
+                padding: 6pt 7pt; font-size: 7.4pt; line-height: 1.35; text-align: justify; }
+  .expediente h3 { font-family: "UnifrakturMaguntia", serif; font-weight: 400; font-size: 13pt;
+                   text-align: center; margin: 0 0 3pt; }
+</style>
+</head>
+<body>
+
+<header>
+  <div class="faixa-topo">
+    <span>Anno {{ anno }}</span>
+    <span>Torrado e moído em Python</span>
+    <span>João Pessoa · Parahyba</span>
+  </div>
+  <img class="mancha" src="img/mancha-cafe.svg" alt="">
+  <div class="cabecalho">
+    <div class="orelha">
+      <img src="img/xicara.svg" alt="">
+      Tirado na hora
+    </div>
+    <h1 class="titulo-jornal">Expresso <span class="pb">PB</span></h1>
+    <div class="orelha caixa">
+      <strong>Edição forte</strong>
+      Curto · sem açúcar<br>moído às 06h00<br>em João Pessoa
+    </div>
+  </div>
+  <p class="lema">“As notícias da capital paraibana, curtas e fortes como um expresso.”</p>
+  <div class="barra-edicao">
+    <span>Nº {{ edicao.numero_edicao }}</span>
+    <span class="data">{{ edicao.data_edicao|date:"l, j \d\e F \d\e Y" }}</span>
+    <span>Preço: um cafezinho</span>
+  </div>
+</header>
+
+{% if manchete %}
+<section class="manchete">
+  {% if manchete.noticia.categoria %}<div class="chapeu">{{ manchete.noticia.categoria }}</div>{% endif %}
+  <h1>{{ manchete.noticia.titulo }}</h1>
+  <div class="texto"><p>{{ manchete.noticia.resumo }}</p></div>
+  <div class="assinatura">
+    <span>Matéria completa em <strong>{{ manchete.noticia.fonte.nome }}</strong>
+      {% if manchete.outras_fontes %}· também em {{ manchete.outras_fontes }}{% endif %}
+      · {{ manchete.noticia.publicado_em|date:"d/m H\hi" }}
+      <span class="ref">[{{ manchete.ref }}]</span></span>
+  </div>
+</section>
+{% endif %}
+
+<section class="colunas">
+  {% for item in demais %}
+  <article class="materia">
+    {% if item.noticia.categoria %}<div class="chapeu">{{ item.noticia.categoria }}</div>{% endif %}
+    <h2>{{ item.noticia.titulo }}</h2>
+    <div class="texto"><p>{{ item.noticia.resumo }}</p></div>
+    <div class="assinatura">
+      <span>Na íntegra em <strong>{{ item.noticia.fonte.nome }}</strong>
+        {% if item.outras_fontes %}· também em {{ item.outras_fontes }}{% endif %}
+        · {{ item.noticia.publicado_em|date:"d/m H\hi" }}
+        <span class="ref">[{{ item.ref }}]</span></span>
+    </div>
+  </article>
+  {% endfor %}
+
+  <aside class="expediente">
+    <h3>Expediente</h3>
+    O Expresso PB é passado na hora por um robô em Python, com grãos dos portais
+    {{ fontes|join:", " }}. Os textos aqui são resumos e chamadas; as matérias
+    completas e seus direitos pertencem aos respectivos veículos. O número entre
+    colchetes ao fim de cada notícia leva ao endereço da matéria original, na seção de Referências.
+    Edição tirada em {{ gerado_em|date:"d/m/Y \à\s H\hi" }}. Sirva-se.
+  </aside>
+</section>
+
+<section class="referencias">
+  <h3>Referências</h3>
+  <p class="nota">Endereços das matérias completas, na ordem em que aparecem nesta edição.</p>
+  <ol>
+    {% for item in referencias %}
+    <li>
+      <span class="num">[{{ item.ref }}]</span><strong>{{ item.noticia.fonte.nome }}</strong>,
+      <span class="titulo">“{{ item.noticia.titulo }}”</span>.
+      <span class="url">{{ item.noticia.link }}</span>
+      {% for outro in item.outros_links %}
+        <br>Também em <strong>{{ outro.fonte }}</strong>: <span class="url">{{ outro.link }}</span>
+      {% endfor %}
+    </li>
+    {% endfor %}
+  </ol>
+</section>
+
+</body>
+</html>
