# Copie para src/.env e ajuste. O cron e o site leem este arquivo.

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=paraipython.seudominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://paraipython.seudominio.com.br

# --- Banco (padrão: SQLite em src/db.sqlite3) ---
# DB_ENGINE=postgresql        # ou mysql
# DB_NAME=usuario_paraipython
# DB_USER=usuario_paraipython
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Apoio dos leitores (página Sobre) ---
# Sem APOIO_PIX_CHAVE, a página mostra dados fictícios com um aviso.
# APOIO_PIX_CHAVE=sua-chave-pix@email.com      # e-mail, CPF/CNPJ, celular (+5583...) ou chave aleatória
# APOIO_PIX_NOME=Seu Nome Completo              # até 25 caracteres, como no banco
# APOIO_PIX_CIDADE=Joao Pessoa                  # até 15 caracteres
# APOIO_PIX_DESCRICAO=Cafezinho pro Expresso PB
# APOIO_PIX_QR_IMAGEM=img/meu-pix.png           # opcional: QR do seu banco salvo em src/static/img/
# APOIO_LINK_NOME=Apoia.se
# APOIO_LINK_URL=https://apoia.se/seu-perfil    # deixe vazio (APOIO_LINK_URL=) para esconder

# --- Robô ---
# PARAIPYTHON_HORARIO_MANHA=06:00
# PARAIPYTHON_HORARIO_NOITE=19:00
# PARAIPYTHON_NOTICIAS_POR_EDICAO=16
# PARAIPYTHON_MAX_POR_TEMA=4
# PARAIPYTHON_JANELA_HORAS=24
# PARAIPYTHON_JANELA_MAXIMA_HORAS=30
# PARAIPYTHON_EDICOES_COMPARADAS=4
# PARAIPYTHON_LIMIAR_DUPLICADA=0.6
# PARAIPYTHON_TAMANHO_RESUMO=320
# PARAIPYTHON_TETO_RESUMO=450
# PARAIPYTHON_LOG_LEVEL=INFO
